{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/preload/*.d.ts",
    "src/preload/types.ts",
    "../sankasten/src/**/*.ts",
    "../sankasten/src/**/*.vue"
  ],
  "exclude": [
    "src/renderer/src/**/*.test.ts",
    "../sankasten/src/**/*.test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@sankasten": [
        "../sankasten/src/index.ts"
      ],
      "@sankasten/*": [
        "../sankasten/src/*"
      ],
      "vue": [
        "node_modules/vue"
      ]
    }
  }
}
